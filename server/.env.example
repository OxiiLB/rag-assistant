# Modèle de configuration — copier vers server/.env et renseigner les valeurs.
# Ne jamais mettre de vraie clé ici : ce fichier est commité, .env ne l'est pas.

# Clé API Anthropic (https://console.anthropic.com) — requise pour le chat
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel
ANTHROPIC_MODEL=claude-sonnet-5
PORT=3000
# Décommenter pour utiliser Qdrant (docker compose up -d) au lieu du store local :
# QDRANT_URL=http://localhost:6333
