# Configuration template — copy to server/.env and fill in the values.
# Never put a real key here: this file is committed, .env is not.

# Anthropic API key (https://console.anthropic.com) — required for chat
ANTHROPIC_API_KEY=sk-ant-...

# Optional
ANTHROPIC_MODEL=claude-sonnet-5
PORT=3000
# Uncomment to use Qdrant (docker compose up -d) instead of the local store:
# QDRANT_URL=http://localhost:6333

# --- Production / public demo ---
# production: also serves the Angular build (web/dist/web/browser) from the same server
# NODE_ENV=production
# Read-only corpus: upload and delete disabled for visitors
# DEMO_MODE=true
# Enable behind a host's proxy, otherwise all visitors share the same rate limit
# TRUST_PROXY=true
# Origins allowed by CORS (only useful outside production, e.g. ng serve)
# CORS_ORIGINS=http://localhost:4200

# Limits (requests per minute per IP)
# RATE_LIMIT_GLOBAL=100
# RATE_LIMIT_CHAT=10
# RATE_LIMIT_UPLOAD=5
# MAX_PAGES=500
